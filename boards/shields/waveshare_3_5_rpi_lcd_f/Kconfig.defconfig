if SHIELD_WAVESHARE_3_5_RPI_LCD_F

if DISPLAY

if LVGL

# Cortex-M0+ has no unaligned-access support; LVGL reads RGB565 image data as
# uint16_t/uint32_t, so force 4-byte alignment of compiled-in image/font data
# to avoid a hard fault in the software blender.
config LV_ATTRIBUTE_MEM_ALIGN_SIZE
	default 4

config LV_Z_VDB_SIZE
	default 32

choice LV_COLOR_DEPTH
	default LV_COLOR_DEPTH_16
endchoice

config INPUT
	default y

config LV_Z_POINTER_INPUT
	default y

endif # LVGL

endif # DISPLAY

endif # SHIELD_WAVESHARE_3_5_RPI_LCD_F
