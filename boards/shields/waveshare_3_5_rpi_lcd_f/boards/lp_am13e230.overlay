 *
 * SPDX-License-Identifier: Apache-2.0
 *
 * Waveshare 3.5" RPi LCD (F) on LP-AM13E230 Rev E2.
 *
 * Panel RPi 40-pin → LP-AM13E230 BoosterPack header → AM13E23019 pin
 * ──────────────────────────────────────────────────────────────────
 * VCC (5V)      pin 4   →  J3-21  (5V rail)
 * GND           pin 6   →  J3-22  (GND)
 * SPI MOSI      pin 19  →  J2-15  PB10  UC3 TX/PICO
 * SPI SCLK      pin 23  →  J1-7   PB5   UC3 SCLK/RX
 * SPI CS        pin 24  →  J2-19  PA21  UC3 CTS/CS0
 * SPI MISO*     pin 21  →  J2-14  PA20  UC3 RTS/POCI  (* write-only, optional)
 * ST7796S DC    pin 15  →  J4-35  PA25  GPIO
 * ST7796S RST   pin 13  →  J3-26  PA17  GPIO
 * Backlight EN  pin 12  →  J3-24  PA18  GPIO
 * GT911 SDA     pin 3   →  J1-10  PA22  UC2 I2C SDA  (2.2 kΩ pull-up J18)
 * GT911 SCL     pin 5   →  J1-9   PA23  UC2 I2C SCL  (2.2 kΩ pull-up J17)
 * GT911 INT     pin 7   →  J2-11  PB11  GPIO
 * GT911 RST     pin 11  →  J3-23  PA16  GPIO
 *
 * Jumpers J17 and J18 must be installed (default) for I2C pull-ups.
 * PA6 (BSL INVOKE), PA8 (EQEP J5), PA13 (SWDIO) are NOT on BoosterPack
 * headers and cannot be used — this overlay avoids all three.
 */

#include <zephyr/dt-bindings/i2c/i2c.h>

&waveshare_3_5_rpi_lcd_f_mipi_dbi {
	dc-gpios    = <&gpiob 5 GPIO_ACTIVE_HIGH>;
	reset-gpios = <&gpiob 15 GPIO_ACTIVE_LOW>;
	spi-dev     = <&unicomm0_spi>;
};

&st7796s_display {
	mipi-max-frequency = <25000000>;
};

/ {
	display_backlight: display-backlight {
		compatible = "regulator-fixed";
		regulator-name = "display-backlight";
		enable-gpios = <&gpioa 18 GPIO_ACTIVE_HIGH>;
		regulator-boot-on;
	};
};

&gpioa {
	status = "okay";
};

&gpiob {
	status = "okay";
};

/* UNICOMM3 as SPI for ST7796S — BoosterPack standard SPI pins */
&unicomm0 {
	status = "okay";
};

/*
 * CS is software (GPIO) controlled so the SPI context can keep it asserted
 * throughout the entire pixel-data burst.  PA21 is NOT muxed to the UNICOMM
 * CTS/CS0 function — it stays as a plain GPIO driven by the SPI context.
 */
&unicomm0_spi {
	status = "okay";
	pinctrl-0 = <&uc0_tx_sda_pico_pa9
	             &uc0_rx_scl_sclk_pa10
	             &uc0_rts_poci_pa20>;
	pinctrl-names = "default";
	cs-gpios = <&gpioa 21 GPIO_ACTIVE_LOW>;
	/* SPI frequency is set via mipi-max-frequency on the display node */
};

/* UNICOMM2 as I2C for GT911 — PA22/PA23 have board pull-ups (J18/J17) */
&unicomm2 {
	status = "okay";
};

&unicomm2_i2c {
	status = "okay";
	pinctrl-0 = <&uc2_tx_sda_pa22 &uc2_rx_scl_pa23>;
	pinctrl-names = "default";
	clock-frequency = <I2C_BITRATE_FAST>;

	gt911_touch: gt911@5d {
		compatible = "goodix,gt911";
		reg = <0x5d>;
		alt-addr = <0x14>;
		irq-gpios   = <&gpiob 10 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&gpiob 18 GPIO_ACTIVE_LOW>;
		screen-width  = <320>;
		screen-height = <480>;
	};
};

&sram0_1_2 {
	reg = <0x20000000 DT_SIZE_K(128)>;
};
