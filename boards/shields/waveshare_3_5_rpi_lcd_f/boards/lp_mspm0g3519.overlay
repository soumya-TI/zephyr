#include <zephyr/dt-bindings/i2c/i2c.h>

&waveshare_3_5_rpi_lcd_f_mipi_dbi {
	dc-gpios    = <&gpiob 7 GPIO_ACTIVE_HIGH>;
	reset-gpios = <&gpioa 9 GPIO_ACTIVE_LOW>;
	spi-dev     = <&spi0>;
};

/ {
	display_backlight: display-backlight {
		compatible = "regulator-fixed";
		regulator-name = "display-backlight";
		enable-gpios = <&gpioa 16 GPIO_ACTIVE_HIGH>;
		regulator-boot-on;
	};
};

&dma {
	status = "okay";
};

&spi0 {
	status = "okay";
	/* DMA channel 0, SPI0 TX trigger = 13 (DMA_SPI0_TX_TRIG in mspm0g351x.h) */
	dmas = <&dma 0 13>;
	dma-names = "tx";
};

/*
 * GT911 on native I2C0 (PA0=SDA / PA1=SCL). This bus has the board's populated
 * 2.2k pull-ups (jumpers J16/J17). PB2/PB3 (i2c1) has no pull-ups and PB3 is
 * tied to the S2 button by J23, so i2c0 is used instead. i2c0 driver support
 * comes from the cherry-picked PR #117311.
 */
&i2c0 {
	status = "okay";
	pinctrl-0 = <&i2c0_sda_pa0 &i2c0_scl_pa1>;
	pinctrl-names = "default";
	clock-frequency = <I2C_BITRATE_FAST>;

	gt911_touch: gt911@5d {
		compatible = "goodix,gt911";
		reg = <0x5d>;
		alt-addr = <0x14>;
		irq-gpios   = <&gpioa 13 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&gpiob 14 GPIO_ACTIVE_LOW>;
		screen-width  = <320>;
		screen-height = <480>;
	};
};

&flash0 {
	reg = <0x0 DT_SIZE_K(512)>;
};

/*
 * Unified 128 KB SRAM region — matches the MSPM0G3519 SDK canonical layout
 * (mspm0g3519.cmd: SRAM_BANK0 = 0x20200000/64KB, SRAM_BANK1 = 0x20210000/64KB,
 * comment: "SRAM on this device is continuous memory").
 *
 *   0x20200000–0x2020FFFF  64 KB  Bank A, no-ECC alias (no init required)
 *   0x20210000–0x2021FFFF  64 KB  Bank B               (no ECC)
 *   ─────────────────────────────────────────────────────────────────────
 *                         128 KB  = 0x20000 bytes total
 *
 * Kernel, stacks, BSS, LVGL VDB and pool all live here as ordinary static
 * arrays — no separate named region needed.  Estimated layout:
 *   kernel BSS + stacks  ~20 KB
 *   VDB  (12%)            36 KB
 *   pool  (60 KB)         60 KB
 *   ───────────────────  ──────
 *   total used           ~116 KB   (10 KB spare)
 *
 * Note: Bank B contents are lost in power modes stronger than SLEEP
 * (SDK linker comment).  Acceptable: the display is off in deep sleep.
 */
&sram0 {
	reg = <0x20200000 DT_SIZE_K(128)>;
};
