<component>
  <previews>
    <preview width="280" height="80" style_bg_color="0xFBFBFC"/>
  </previews>
  <api>
    <prop name="title"    type="string"  default="Door interlock"/>
    <prop name="on_text"  type="string"  default="Locked"/>
    <prop name="off_text" type="string"  default="Unlocked"/>
    <prop name="state"    type="subject" default="subject_door"/>
    <prop name="w"        type="int"     default="152"/>
  </api>
  <styles>
    <style name="style_dot" width="9" height="9" radius="32767"/>
  </styles>
  <view extends="lv_button" width="$w" height="content" state_trickle="true"
        style_bg_opa="0" style_border_width="0" style_shadow_width="0"
        style_pad_top="7" style_pad_bottom="7" style_pad_left="0" style_pad_right="0"
        style_layout="flex" style_flex_flow="row"
        style_flex_main_place="space_between" style_flex_cross_place="center"
        style_flex_track_place="center">
    <subject_toggle_event subject="$state" trigger="clicked"/>

    <column gap="1">
      <label text="$title" clickable="false">
        <style name="style_body_strong"/>
        <style name="style_ink"/>
      </label>
      <label text="$on_text" clickable="false">
        <style name="style_micro"/>
        <style name="style_ink_accent"/>
        <bind_flag_if_not_eq flag="hidden" subject="$state" ref_value="#ref_on"/>
      </label>
      <label text="$off_text" clickable="false">
        <style name="style_micro"/>
        <style name="style_ink_3"/>
        <bind_flag_if_not_eq flag="hidden" subject="$state" ref_value="#ref_off"/>
      </label>
    </column>

    <lv_obj width="9" height="9" scrollable="false" clickable="false"
            style_radius="32767" style_border_width="0" style_shadow_width="0"
            style_pad_all="0">
      <style name="style_chip_dot_accent"/>
      <bind_flag_if_not_eq flag="hidden" subject="$state" ref_value="#ref_on"/>
    </lv_obj>
    <lv_obj width="9" height="9" scrollable="false" clickable="false"
            style_radius="32767" style_border_width="0" style_shadow_width="0"
            style_pad_all="0">
      <style name="style_chip_dot_neutral"/>
      <bind_flag_if_not_eq flag="hidden" subject="$state" ref_value="#ref_off"/>
    </lv_obj>
  </view>
</component>
