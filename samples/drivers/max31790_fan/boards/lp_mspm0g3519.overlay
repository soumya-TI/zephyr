/*
 * SPDX-License-Identifier: Apache-2.0
 *
 * MAX31790 accessed via the UART-to-I2C bridge driver.
 * UART1 (PB4/PB5) connects to the fixed-function MSPM0G bridge MCU
 * running uart_i2c_bridge firmware (SHared_i2c protocol), which
 * translates UART frames to I2C and drives the MAX31790 fan controller.
 *
 * Wiring:
 *   lp_mspm0g3519 PB4 (UART1 TX) → bridge MCU UART RX (PA11)
 *   lp_mspm0g3519 PB5 (UART1 RX) → bridge MCU UART TX (PA10)
 *   GND ↔ GND
 */

&uart1 {
	status = "okay";
	current-speed = <9600>;
	pinctrl-0 = <&uart1_tx_pb4 &uart1_rx_pb5>;
	pinctrl-names = "default";
};

/ {
	uart_i2c0: uart-i2c-bridge {
		compatible = "uart-i2c-bridge";
		uart-dev = <&uart1>;
		response-timeout-ms = <200>;
		#address-cells = <1>;
		#size-cells = <0>;

		fan_ctrl: max31790@50 {
			compatible = "maxim,max31790";
			reg = <0x50>;

			fan_pwm: max31790-pwm {
				compatible = "maxim,max31790-pwm";
				#pwm-cells = <2>;
			};

			fan_speed_1: max31790-fan-speed {
				compatible = "maxim,max31790-fan-speed";
				channel = <1>;
			};

			fan_fault: max31790-fan-fault {
				compatible = "maxim,max31790-fan-fault";
			};
		};
	};
};
