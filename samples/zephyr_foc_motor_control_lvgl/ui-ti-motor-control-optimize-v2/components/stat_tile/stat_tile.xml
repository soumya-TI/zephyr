<component>
  <!-- The inset variant of `stat`: same grammar, on a surface that steps DOWN
       past the canvas. An inset is defined by being darker, not by an outline. -->
  <previews><preview width="288" height="90" style_bg_color="0x191E23" /></previews>
  <api>
    <prop name="caption" type="string" default="PEAK" />
    <prop name="value" type="subject" />
    <prop name="fmt" type="string" default="%d" />
    <prop name="placeholder" type="string" default="0" />
    <prop name="unit" type="string" default="RPM" />
    <prop name="col_w" type="int" default="132" />
  </api>
  <view extends="column" width="$col_w" height="content" gap="#const_space_4"
        pad_left="#const_space_12" pad_right="#const_space_12"
        pad_top="#const_space_12" pad_bottom="#const_space_12">
    <style name="style_inset" />

    <label text="$caption">
      <style name="style_overline" />
      <style name="style_ink_overline" />
    </label>

    <row gap="#const_space_2" cross_align="end">
      <label bind_text="$value" bind_text-fmt="$fmt" text="$placeholder">
        <style name="style_stat_md" />
        <style name="style_ink" />
      </label>
      <label text="$unit" style_pad_bottom="2">
        <style name="style_meta" />
        <style name="style_ink_tertiary" />
      </label>
    </row>
  </view>
</component>
