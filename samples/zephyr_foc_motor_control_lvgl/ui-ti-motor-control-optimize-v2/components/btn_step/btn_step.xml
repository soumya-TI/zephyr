<component>
  <!-- 64x64: above the 56px floor, since a reference gets nudged repeatedly
       while watching the shaft rather than the screen. The caller supplies the
       write as a child <subject_increment_event>, so this needs no C. -->
  <previews><preview width="120" height="80" style_bg_color="0x191E23" /></previews>
  <api>
    <prop name="icon" type="image" default="icon_plus" />
  </api>
  <view extends="lv_button" width="64" height="64">
    <style name="style_btn_base" />
    <style name="style_btn_ghost" />
    <style name="style_btn_ghost_pressed" selector="pressed" />
    <row clickable="false" width="100%" height="100%" main_align="center" cross_align="center">
      <lv_image src="$icon" width="28" height="28" clickable="false">
        <style name="style_icon_ink" />
      </lv_image>
    </row>
  </view>
</component>
